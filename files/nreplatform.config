# One 'port' section per rule.
#
#   enabled    1 / 0
#   device     network device: eth0.1, eth1, br-lan, wlan0, ...
#              (WRT160NL: the LAN ports are behind a switch chip and are NOT
#               separate devices - use eth0.1 for all LAN ports, eth1 for WAN)
#   direction  egress  = traffic leaving the router through this device
#                        (= download of the client behind it)
#              ingress = traffic entering the router from this device
#                        (= upload of the client behind it, uses an ifb device)
#              both
#   latency    added delay in ms, 0..60000        (0 = off)
#   jitter     +/- delay variation in ms          (0 = off, needs latency > 0,
#                                                  limited to latency)
#   loss       random packet loss in percent      (0..100, 0 = off)
#   rate       maximum speed in Mbit/s            (0 = unlimited)
#   queue      netem queue length in packets      (optional, 16..10000,
#                                                  default: automatic 1000..4000)
#
# Only one rule per device and direction. Do not use the same device as
# SQM / qos-scripts: they also own its root qdisc.

config port
	option enabled '0'
	option device 'eth0.1'
	option direction 'both'
	option latency '50'
	option jitter '5'
	option loss '1'
	option rate '100'
